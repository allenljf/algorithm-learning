# Copy this file to infra/env/.env and replace every secret placeholder. This
# local file is ignored; do not use these placeholder values outside local setup.
POSTGRES_DB=algorithm_learning
POSTGRES_USER=algorithm_learning
POSTGRES_PASSWORD=__REPLACE_WITH_LOCAL_SECRET__
DATABASE_URL=jdbc:postgresql://postgres:5432/algorithm_learning
DATABASE_USERNAME=algorithm_learning
DATABASE_PASSWORD=__REPLACE_WITH_LOCAL_SECRET__
APP_JWT_KEY=__REPLACE_WITH_LOCAL_SECRET__
APP_REFRESH_HASH_KEY=__REPLACE_WITH_LOCAL_SECRET__
APP_JWT_ISSUER=algorithm-learning-api
APP_JWT_AUDIENCE=algorithm-learning-client
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
